# App runtime connection — use a least-privilege Postgres role scoped to
# only this app's tables (SELECT/INSERT/UPDATE/DELETE, no DDL), not the
# default `postgres` owner role. Via the shared transaction-mode pooler
# (IPv4-only).
DATABASE_URL="postgresql://app_role.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=replace-with-a-long-random-value

# Project Settings > Data API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys > Secret key — server-side only, never ship to a client
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-key
# Storage bucket PDFs are uploaded to — must exist already (private bucket)
SUPABASE_STORAGE_BUCKET=pdfs

# Authenticates Vercel Cron's requests to /api/cron/prune-rate-limits.
# Vercel sets this automatically for Cron-triggered requests in production
# once the var exists in the project's env settings — generate any long
# random value (e.g. `openssl rand -hex 32`) and set it there too.
CRON_SECRET=replace-with-a-long-random-value
